generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
  CASH
  BOLETO
  TRANSFER
  OTHER
}

enum TransactionSource {
  MANUAL
  NUBANK_CARD_CSV
  NUBANK_ACCOUNT_CSV
  NUBANK_PDF
  OFX
  RECURRING
}

model User {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(120)
  email         String   @unique @db.VarChar(180)
  passwordHash  String   @db.VarChar(100)
  monthlyIncome Decimal  @default(0) @db.Decimal(12, 2)
  payday        Int      @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categories   Category[]
  transactions Transaction[]
  recurrings   Recurring[]
  imports      ImportBatch[]
  goals        Goal[]

  @@map("users")
}

model Category {
  id            String          @id @default(cuid())
  userId        String
  name          String          @db.VarChar(60)
  color         String          @db.VarChar(9)
  icon          String          @db.VarChar(40)
  type          TransactionType @default(EXPENSE)
  keywords      String          @default("") @db.VarChar(1000)
  monthlyBudget Decimal?        @db.Decimal(12, 2)
  createdAt     DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurrings   Recurring[]

  @@unique([userId, name, type])
  @@map("categories")
}

model Transaction {
  id                String            @id @default(cuid())
  userId            String
  categoryId        String?
  type              TransactionType
  description       String            @db.VarChar(255)
  amount            Decimal           @db.Decimal(12, 2)
  /// Data de competência: mês em que a despesa conta (para cartão = vencimento da fatura)
  date              DateTime          @db.Date
  /// Data original da compra (itens de fatura de cartão)
  purchaseDate      DateTime?         @db.Date
  paymentMethod     PaymentMethod     @default(OTHER)
  source            TransactionSource @default(MANUAL)
  installmentNumber Int?
  installmentTotal  Int?
  notes             String?           @db.VarChar(500)
  fingerprint       String?           @db.VarChar(80)
  importBatchId     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([userId, categoryId, date])
  @@index([importBatchId])
  @@map("transactions")
}

model Recurring {
  id            String          @id @default(cuid())
  userId        String
  categoryId    String?
  type          TransactionType @default(EXPENSE)
  description   String          @db.VarChar(255)
  amount        Decimal         @db.Decimal(12, 2)
  dayOfMonth    Int
  paymentMethod PaymentMethod   @default(OTHER)
  active        Boolean         @default(true)
  startDate     DateTime        @db.Date
  endDate       DateTime?       @db.Date
  createdAt     DateTime        @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, active])
  @@map("recurrings")
}

model ImportBatch {
  id         String            @id @default(cuid())
  userId     String
  fileName   String            @db.VarChar(255)
  source     TransactionSource
  totalItems Int
  createdAt  DateTime          @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, createdAt])
  @@map("import_batches")
}

model Goal {
  id            String    @id @default(cuid())
  userId        String
  name          String    @db.VarChar(120)
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  deadline      DateTime? @db.Date
  color         String    @default("#10b981") @db.VarChar(9)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}
